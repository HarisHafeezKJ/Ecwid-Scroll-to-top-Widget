{
  "name": "Scroll to Top",
  "namespace": "scroll-to-top-app",
  "description": "Adds a customizable scroll-to-top button with progress indicator to the Ecwid storefront.",
  "version": "1.0.0",
  "scopes": [
    "read_store_profile",
    "customize_storefront",
    "add_to_cp"
  ],
  "endpoints": {
    "iframeUrl": "https://cdn.jsdelivr.net/gh/HarisHafeezKJ/Ecwid-Scroll-to-top-Widget@main/admin.html",
    "customJsUrl": "https://cdn.jsdelivr.net/gh/HarisHafeezKJ/Ecwid-Scroll-to-top-Widget@main/widget.js"
  },
  "publicConfigKeys": [
    "appEnabled",
    "scrollThreshold",
    "shape",
    "buttonBackground",
    "iconColor",
    "progressBarColor",
    "icon",
    "progressBarEnabled"
  ]
}
